# ─────────────────────────────────────────────────────────────
#  Stash configuration — copy this file to `.env` and edit.
#  Every value here is optional; the app runs fine with none.
# ─────────────────────────────────────────────────────────────

# Port the web server listens on.
PORT=8080

# Bind address. Keep 127.0.0.1 to stay private to this machine.
# Use 0.0.0.0 to expose it on your local network.
HOST=127.0.0.1


# ── Spotify / Apple Music ────────────────────────────────────
# Spotify audio is DRM-protected and cannot be downloaded from
# Spotify. Stash reads the *metadata* (title, artist, album,
# cover art, track order) and sources the audio from YouTube,
# then tags it. Without credentials it falls back to scraping
# the public embed page, which caps playlists at ~100 tracks.
#
# Free to create at https://developer.spotify.com/dashboard
# ("Create app" -> copy Client ID + Client Secret).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=


# ── Private / age-restricted content ─────────────────────────
# Instagram, private YouTube videos and age-gated content need
# your login cookies. Pick ONE of the two options below.
#
# 1) Pull cookies straight from an installed browser.
#    Values: chrome | firefox | edge | brave | opera | vivaldi | safari
#    Close the browser first — Chrome locks its cookie DB.
COOKIES_FROM_BROWSER=

# 2) Or point at a Netscape-format cookies.txt file exported
#    with a "Get cookies.txt" browser extension.
COOKIES_FILE=

# 3) On a hosted server you cannot upload a file, so paste the
#    cookies.txt CONTENTS here instead. Literal \n between lines
#    is fine if your dashboard only accepts one line.
COOKIES_CONTENT=


# ── Public deployment ────────────────────────────────────────
# Shared password. Leave blank on your own machine. SET IT before
# putting Stash on a public URL, or strangers will find it and run
# their downloads on your bandwidth and your bill.
ACCESS_PASSWORD=

# How many proxy hops to trust for the client IP. Use 1 behind
# Railway, Render, Fly or nginx; "loopback" when running locally.
TRUST_PROXY=loopback

# Sites allowed to call this engine from a browser. Needed only when
# the page is served from somewhere else — a static interface on
# Vercel talking to this engine, say. Comma separated. A "*" in a
# pattern matches anything up to the next "/", so
# https://*.vercel.app covers every preview deployment. A bare "*"
# allows any site, which is only sensible with ACCESS_PASSWORD set.
CORS_ORIGINS=

# Refuse new jobs once the download folder passes this size.
MAX_DISK_USAGE_MB=8192


# ── Limits ───────────────────────────────────────────────────
# How many downloads run at the same time.
MAX_CONCURRENT_JOBS=3

# Maximum items pulled from a single playlist/album.
MAX_PLAYLIST_ITEMS=200

# Delete finished downloads from disk after this many minutes.
# Set to 0 to keep files forever (you must clean up yourself).
FILE_TTL_MINUTES=180

# Requests per minute per IP address.
RATE_LIMIT_PER_MINUTE=60

# Cap on a single download, in megabytes. 0 = unlimited.
MAX_FILESIZE_MB=0


# ── Paths ────────────────────────────────────────────────────
# Where finished files are written. Defaults to ./downloads
DOWNLOAD_DIR=

# Explicit binary paths, if they are not on your PATH.
YTDLP_PATH=
FFMPEG_PATH=
